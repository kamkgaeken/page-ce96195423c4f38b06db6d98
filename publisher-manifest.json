olumns:1fr;gap:14px}\n    .steps,.faqgrid,.clients{grid-template-columns:1fr}\n    .step{border-right:0}\n    .step:nth-child(2n){border-right:0}\n    .step:nth-last-child(-n+2){border-bottom:2px solid var(--line)}\n    .step:last-child{border-bottom:0}\n    .client{border-right:0}\n    .client:last-child{border-bottom:0}\n    .client:nth-last-child(-n+2){border-bottom:2px solid var(--line)}\n    footer{padding:24px 22px 36px}\n  }\n</style><div class=\"shell\">\n\n  <aside class=\"side\">\n    <div class=\"mark\">仓鼠<span>宝宝</span></div>\n    <div class=\"sub\">套餐 · 使用 · 答疑</div>\n    <nav>\n      <a href=\"#plans\">套餐对比 <i>01</i></a>\n      <a href=\"#howto\">怎么开始用 <i>02</i></a>\n      <a href=\"#clients\">支持哪些设备 <i>03</i></a>\n      <a href=\"#faq\">常见问题 <i>04</i></a>\n      <a href=\"#contact\">找我们 <i>05</i></a>\n    </nav>\n    <div class=\"foot\">\n      价格与权益以本页为准，<br>下单前请再核对一遍。\n    </div>\n  </aside>\n\n  <main>\n\n    <header class=\"band solid-orange\">\n      <p class=\"eyebrow\">仓鼠宝宝 · 把话说清楚</p>\n      <h1>仓鼠宝宝<em>先看价格，再看能不能连，最后再决定。</em></h1>\n      <p class=\"lead\">我们不太会写漂亮话。这里放的是三档套餐的真实价格、每档能连几台设备、遇到问题怎么找人。看完你就知道该选哪一档，或者干脆先不选。</p>\n    </header>\n\n    <div class=\"band soft\">\n      <div class=\"layered\">\n        <div class=\"fact\">\n          <b>三档</b>\n          <span>基础 / 旗舰 / 团队，按需挑</span>\n        </div>\n        <div class=\"fact\">\n          <b>3 / 5 / 20 台</b>\n          <span>各档同时在线设备数</span>\n        </div>\n        <div class=\"fact\">\n          <b>年付 10 个月价</b>\n          <span>三档均按此比例折算</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"band plain\">\n      <p class=\"intro\">很多人第一次来会问：是不是越贵越好？其实不是。看你在几个屏幕上用、每天用多久、要不要连机房或者公司网络，答案自然就出来了。下面的表格我们把差别并排摆出来，你可以横向比一比。</p>\n    </div>\n\n    <section class=\"block\" id=\"plans\">\n      <p class=\"kicker\">01 / 套餐</p>\n      <h2>三档套餐摆在一张表里</h2>\n      <p class=\"muted\">同一行对比同一项，不用来回翻页。月付和年付都在表里标了，年付按十个月计价，不是打折噱头。</p>\n\n      <div class=\"tablewrap\">\n        <table>\n          <thead>\n            <tr>\n              <th>对比项</th>\n              <th>基础版</th>\n              <th class=\"feat\">旗舰版<span class=\"tag\">多数人</span></th>\n              <th>团队版</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td class=\"name\">价格</td>\n              <td class=\"price\"><b>¥15/月</b><span>年付 ¥150</span></td>\n              <td class=\"price\"><b>¥35/月</b><span>年付 ¥350</span></td>\n              <td class=\"price\"><b>¥85/月</b><span>年付 ¥850</span></td>\n            </tr>\n            <tr>\n              <td class=\"name\">每月流量</td>\n              <td>100GB</td>\n              <td>300GB</td>\n              <td>1000GB</td>\n            </tr>\n            <tr>\n              <td class=\"name\">同时在线设备</td>\n              <td>3 台</td>\n              <td>5 台</td>\n              <td>20 台</td>\n            </tr>\n            <tr>\n              <td class=\"name\">线路</td>\n              <td>普通线路节点池</td>\n              <td>IPLC 专线</td>\n              <td>VIP 专属高带宽节点</td>\n            </tr>\n            <tr>\n              <td class=\"name\">流媒体</td>\n              <td>基础流媒体解锁</td>\n              <td>全节点原生流媒体解锁</td>\n              <td>随团队版节点一并提供</td>\n            </tr>\n            <tr>\n              <td class=\"name\">游戏 / 低延迟</td>\n              <td>不包含</td>\n              <td>专线游戏加速优化</td>\n              <td>高带宽节点优先调度</td>\n            </tr>\n            <tr>\n              <td class=\"name\">路由</td>\n              <td>标准路由</td>\n              <td>标准路由</td>\n              <td>支持企业定制路由</td>\n            </tr>\n            <tr>\n              <td class=\"name\">支持</td>\n              <td>工单支持</td>\n              <td>7×24 优先工单</td>\n              <td>专属客户经理</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n      <p class=\"table-note\">挑不准的话：一个人两三个屏幕，基础版够；手机平板电脑一起挂、还想看流媒体，旗舰版划算；一个小团队要统一管线路，再考虑团队版。</p>\n    </section>\n\n    <section class=\"block\" id=\"howto\">\n      <p class=\"kicker\">02 / 使用</p>\n      <h2>四步，从注册到连上</h2>\n      <p class=\"muted\">不复杂，但顺序别乱。我们按实际操作顺序写的，照着来就行。</p>\n\n      <div class=\"steps\">\n        <div class=\"step\">\n          <span class=\"n\">01</span>\n          <h3>先把用途想清楚</h3>\n          <p>在纸上写两件事：平时会同时开几个设备、每月大概用多少流量。这两个数字决定你选哪一档，比你问十个人都管用。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"n\">02</span>\n          <h3>选套餐并开通</h3>\n          <p>对照上面那张表选一档，确认月付还是年付。年付折算下来相当于十个月的钱，如果你确定会用满一年，再选年付。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"n\">03</span>\n          <h3>在设备上配置</h3>\n          <p>安装对应平台的客户端，按引导导入配置。第一次配置建议只在一台设备上做，跑通了再复制到其他设备，出问题好定位。</p>\n        </div>\n        <div class=\"step\">\n          <span class=\"n\">04</span>\n          <h3>记下在线设备数</h3>\n          <p>各档同时在线设备数是硬上限：基础版 3 台、旗舰版 5 台、团队版 20 台。用完就关掉不用的设备，别让名额白白占着。</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"block\" id=\"clients\">\n      <p class=\"kicker\">03 / 设备</p>\n      <h2>你手上这些设备，分别怎么用</h2>\n      <p class=\"muted\">下载入口请以我们给出的官方渠道为准，本页不提供安装包，也不放第三方下载链接。</p>\n\n      <div class=\"clients\">\n        <div class=\"client\">\n          <span class=\"platform\">桌面</span>\n          <h3>Windows 与 macOS 电脑</h3>\n          <p>适合长时间挂着用的场景。配置完成后可以设为开机自动连接，注意一台电脑算一台在线设备。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"platform\">移动</span>\n          <h3>iOS 与 Android 手机</h3>\n          <p>手机上切换配置比较频繁，建议把常用的那份配置置顶。手机和平板分开算设备数，别混在一起数。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"platform\">平板</span>\n          <h3>iPad 与安卓平板</h3>\n          <p>看视频场景多的话，旗舰版的流媒体解锁会更省事。平板的耗电和常驻连接比手机更稳定。</p>\n        </div>\n        <div class=\"client\">\n          <span class=\"platform\">局域网</span>\n          <h3>路由器与团队共享</h3>\n          <p>整屋或整间办公室共用一份配置时，先确认同时在线的终端数量没有越过所选档位的上限。</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"block\" id=\"faq\">\n      <p class=\"kicker\">04 / 常见问题</p>\n      <h2>大家反复问的那几个</h2>\n      <p class=\"muted\">左边偏选套餐，右边偏使用和售后。没找到答案就往页尾看联系方式。</p>\n\n      <div class=\"faqgrid\">\n        <div class=\"qa\">\n          <h3>年付是不是自动续费？</h3>\n          <p>年付是按年一次性结算的价格，¥150 / ¥350 / ¥850 分别是三档的年付总额。是否续费由你自己决定，不会替你默认扣款。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>同时在线设备怎么算？</h3>\n          <p>一台正在保持连接的设备算一台。手机、电脑、平板各自独立计数。基础版 3 台、旗舰版 5 台、团队版 20 台，超出时先断开不用的那台。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>流量当月用不完能留到下个月吗？</h3>\n          <p>每月流量按当月额度计，100GB / 300GB / 1000GB 分别对应三档。额度不累加到下个月，所以选档时按自己真实的月均用量来，不必买大的囤着。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>可以先月付试试，再改年付吗？</h3>\n          <p>可以按月付起步，用一两个月确认合适了再考虑年付。年付的核心差别只是计价周期和总额，套餐本身的流量与设备数不变。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>IPLC 专线和普通线路差在哪？</h3>\n          <p>旗舰版用的是 IPLC 专线，团队版是 VIP 专属高带宽节点。差别主要体现在高峰时段的稳定性和延迟表现，基础版则是普通线路节点池。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>团队版需要提供什么信息？</h3>\n          <p>团队版支持企业定制路由，也有专属客户经理对接。具体要沟通哪些内容，涉及你的实际网络结构，建议先咨询再决定，别急着下单。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>遇到问题找谁？</h3>\n          <p>基础版走工单；旗舰版有 7×24 优先工单；团队版可以直接找专属客户经理。工单里把设备、出现时间和现象写清楚，处理会快很多。</p>\n        </div>\n        <div class=\"qa\">\n          <h3>换了新设备要重新算名额吗？</h3>\n          <p>要。旧设备断开后名额才会释放。换机时先在新设备配置好再关旧设备，可以避免中途掉线。</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"block\" id=\"contact\">\n      <p class=\"kicker\">05 / 联系我们</p>\n      <h2>还没定？聊两句也行</h2>\n      <p>如果你卡在“我到底该选哪一档”，把使用场景说清楚——几个设备、主要做什么、每天大概多久——我们可以一起看看哪档更合适，不合适也会直接讲。</p>\n      <p class=\"muted\">咨询入口与工单入口请以我们正式公布的联系方式为准；本页不设在线表单，也不收集你的账号信息。</p>\n\n      <h3>下单前请再确认三件事</h3>\n      <p>一，确认价格是月付还是年付；二，确认同时在线的设备数量；三，确认所选档位的线路类型符合你的使用场景。这三项确认完，基本不会有意外。</p>\n    </section>\n\n    <footer>\n      <strong>仓鼠宝宝</strong> · 套餐价格、流量额度与设备数量以本页表格为准。页面内容为品牌说明用途，不构成对网络性能或服务可用性的承诺。\n    </footer>\n\n  </main>\n</div>",
